# SQLite file for local use. Swap the provider in prisma/schema.prisma to
# "postgresql" and point this at Neon when deploying.
DATABASE_URL="file:./dev.db"

# Optional. A Discogs personal access token (discogs.com/settings/developers)
# unlocks release search and per-condition price suggestions. Release lookup
# and marketplace stats work without it.
DISCOGS_TOKEN=""
